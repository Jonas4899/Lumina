{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug FastAPI",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
            "module": "uvicorn",
            // 1. ESTO ES VITAL: Le dice a VS Code que se ubique en la carpeta 'backend'
            "cwd": "${workspaceFolder}/backend",
            "args": [
                // 2. Ruta actualizada: carpeta 'app', archivo 'main', objeto 'app'
                "app.main:app",
                "--reload",
                "--port",
                "8000"
            ],
            "jinja": true,
            "justMyCode": true,
            // Opcional: Si tienes las variables de entorno en la raíz del proyecto
            "envFile": "${workspaceFolder}/backend/.env"
        }
    ]
}